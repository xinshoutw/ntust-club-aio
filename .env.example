# ===== 恆不變的環境設定(會變動的營運參數放 DB system_settings)=====
# 複製為 .env 後填入實際值;.env 絕不進 git
# 正式環境(ENV=prod)會強制檢查:SECRET_KEY ≥32 字元、POSTGRES_PASSWORD 非預設值

ENV=dev
SECRET_KEY=change-me-to-a-long-random-string

# 信任代理(逗號分隔;compose 子網已內建預設)。部署時務必加 edge VM 內網 IP,
# 否則所有請求的 client IP 會塌縮成 edge IP(限流變全域、稽核全同 IP)。絕不可用 *
# FORWARDED_ALLOW_IPS=172.28.0.0/24,10.140.0.2

# --- PostgreSQL ---
# 本機開發:後端預設連 localhost:5432(compose 的 db 有映射),不用改
POSTGRES_USER=club
POSTGRES_PASSWORD=club
POSTGRES_DB=club_aio
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- 檔案上傳目錄(本機開發)---
UPLOAD_DIR=./data/uploads

# 容器內固定是 /srv/uploads;這裡指定它掛到宿主的哪裡。
# 留空=具名 volume;給絕對路徑=bind mount(檔案 sftp 送得進去、備份讀得到)
# UPLOADS_PATH=/srv/club-aio/uploads

# --- Discord Webhook:無社團可推的系統事件(行政手動借用、公告蓋板與刪除、報名場次刪除)與 infra 告警;社團事件與公告只推各社團自設的 ---
DISCORD_WEBHOOK_URL=

# --- Uptime Kuma push monitor(空值=停用;只在 ENV=prod 送出)---
UPTIME_PUSH_BACKEND_URL=
UPTIME_PUSH_FRONTEND_URL=
UPTIME_PUSH_INTERVAL=30
WEB_HEALTH_URL=http://web/

# --- SMTP:校方 relay(decisions.md OPS-06);MAIL_FROM_ADDRESS 必須與 SMTP_USERNAME 同網域 ---
SMTP_HOST=mail.ntust.edu.tw
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=臺科大社團管理

# 通知信正文與 Discord 頭像的連結來源;漏填會指向 localhost
SITE_URL=https://clubs.ntust.edu.tw

# --- 部署 ---
# 內層 web 容器發布到哪個位址;絕不可綁 0.0.0.0(見 compose.yml 的說明)
# 同機 Docker 上的 Nginx Proxy Manager:填 172.17.0.1,NPM 的 Forward Hostname 也填這個
WEB_BIND=127.0.0.1
WEB_PORT=8080
# BACKEND_IMAGE=ghcr.io/<user>/club-aio-backend:latest
# WEB_IMAGE=ghcr.io/<user>/club-aio-web:latest
