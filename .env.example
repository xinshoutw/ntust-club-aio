# ===== 恆不變的環境設定(會變動的營運參數放 DB system_settings)=====
# 複製為 .env 後填入實際值;.env 絕不進 git

ENV=dev
SECRET_KEY=change-me

# --- PostgreSQL(compose 服務)---
POSTGRES_USER=club
POSTGRES_PASSWORD=club
POSTGRES_DB=club_aio

# --- 本機開發直連(compose 內由 DATABASE_URL 自動組合,不用改)---
DATABASE_URL=postgresql+asyncpg://club:club@localhost:5432/club_aio

# --- 檔案上傳目錄(本機開發)---
UPLOAD_DIR=./data/uploads

# --- SMTP(relay 未定,先用 iCloud+ 自訂網域)---
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=me@xinshou.tw
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=me@xinshou.tw
MAIL_FROM_NAME=noreply

# --- 部署 ---
WEB_PORT=8080
# BACKEND_IMAGE=ghcr.io/<user>/club-aio-backend:latest
# WEB_IMAGE=ghcr.io/<user>/club-aio-web:latest
